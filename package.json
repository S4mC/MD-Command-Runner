{
  "name": "command-runner-v2",
  "displayName": "MD Command Runner",
  "description": "Run commands in the terminal from markdowns files with custom display names and named terminals.",
  "publisher": "s4mu31",
  "version": "0.5.3",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/S4mC/MD-Command-Runner"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "cmd",
    "markdown",
    "run",
    "codelens",
    "command execution",
    "named terminals",
    "custom display"
  ],
  "activationEvents": [
    "onLanguage:Markdown",
    "onLanguage:plaintext"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Executing commands from documents requires a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "title": "Enable",
        "command": "command-runner.enableCodeLens",
        "category": "Command Runner"
      },
      {
        "title": "Disable",
        "command": "command-runner.disableCodeLens",
        "category": "Command Runner"
      },
      {
        "title": "Show Command History",
        "command": "command-runner.showHistory",
        "category": "Command Runner"
      },
      {
        "title": "Clear Command History",
        "command": "command-runner.clearHistory",
        "category": "Command Runner"
      }
    ],
    "configuration": {
      "properties": {
        "command-runner.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable CodeLens for command execution"
        },
        "command-runner.enableDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable visual decorations around commands"
        },
        "command-runner.decorationStyle": {
          "type": "string",
          "default": "background",
          "enum": [
            "background",
            "outline"
          ],
          "description": "Choose how commands are decorated: subtle full-line background or outlined box"
        },
        "command-runner.showHoverInfo": {
          "type": "boolean",
          "default": true,
          "description": "Show execution statistics when hovering over commands"
        },
        "command-runner.decorationBorderColor": {
          "type": "string",
          "default": "#569cd6",
          "description": "Border color for command decorations (hex color code)"
        },
        "command-runner.decorationBackgroundColor": {
          "type": "string",
          "default": "rgba(86, 156, 214, 0.1)",
          "description": "Background color for command decorations (rgba or hex color code)"
        },
        "command-runner.codeLensIcon": {
          "type": "string",
          "default": "▶︎",
          "enum": ["▶︎", "►", "▶", "⚡", "🚀", "⚙️", "✦", "●"],
          "description": "Icon to display in CodeLens buttons"
        },
        "command-runner.confirmDangerousCommands": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Ask for confirmation before executing recognized dangerous commands. Disabled unless explicitly enabled by the user."
        },
        "command-runner.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 300,
          "description": "Interval in seconds to refresh time-ago information in CodeLens and hover tooltips (5-300 seconds)"
        },
        "command-runner.maxDisplayLength": {
          "type": "number",
          "default": 15,
          "description": "Maximum length for command display in CodeLens before truncation"
        },
        "command-runner.maxCustomNameLength": {
          "type": "number",
          "default": 50,
          "description": "Maximum length for custom display names before truncation"
        }
      }
    },
    "grammars": [
      {
        "scopeName": "command-runner.markdown.injection",
        "path": "./syntaxes/command-runner-md.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.command-runner.shell": "shellscript",
          "meta.embedded.block.command-runner.powershell": "powershell",
          "meta.embedded.block.command-runner.python": "python",
          "meta.embedded.block.command-runner.javascript": "javascript",
          "meta.embedded.block.command-runner.typescript": "typescript"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "mocha out/test/suite/**/*.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "glob": "^14.0.4",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "@vscode/test-electron": "^3.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "mocha": {
      "glob": "$glob"
    }
  }
}
